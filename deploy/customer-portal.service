[Unit]
Description=Launchstead Customer Portal (HTTPS, test billing)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=launchstead-portal
Group=launchstead-portal
ExecStart=/opt/launchstead-portal/customer-portal --listen 10.8.0.1:8791 --origin https://portal.0xivanov.dev --database /var/lib/launchstead-portal/portal.sqlite --tls-cert /etc/launchstead-portal/tls.crt --tls-key /etc/launchstead-portal/tls.key --signup --smtp-config /etc/launchstead-portal/smtp.json --mail-key-file /etc/launchstead-portal/mail-key --node-projects /etc/launchstead-portal/node-projects.json --publication-sites /etc/launchstead-portal/publication-sites.json --test-billing --test-billing-management-config /etc/launchstead-portal/billing-test.json --test-webhook-secret-file /etc/launchstead-portal/stripe-webhook-secret
Restart=on-failure
RestartSec=15
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/launchstead-portal
CapabilityBoundingSet=
MemoryMax=384M
TasksMax=128

[Install]
WantedBy=multi-user.target
