[Unit]
Description=Forward Node demo HTTPS through the private Mac tunnel
Requires=node-demo-content.socket
After=node-demo-content.socket
[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:8944
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
