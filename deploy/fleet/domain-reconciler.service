[Unit]
Description=Reconcile verified Launchstead custom domains
After=network-online.target customer-portal.service k3s.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/launchstead-fleet/reconcile-domains.py
User=root
Group=root
UMask=0077
TimeoutStartSec=180
