[Unit]
Description=Launchstead customer release fleet worker
After=network-online.target customer-portal.service docker.service
[Service]
ExecStart=/opt/launchstead-fleet/fleet-worker --config /etc/launchstead-fleet/worker.json
User=launchstead-portal
Group=launchstead-portal
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
MemoryMax=512M
TasksMax=128
[Install]
WantedBy=multi-user.target
